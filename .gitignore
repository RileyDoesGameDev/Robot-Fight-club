# Dependencies
node_modules/

# Build / deploy output
dist/
build/
out/
*.tsbuildinfo

# Blender / DCC scratch
*.blend1
*.blend2
*.spp.autosave

# Engine scratch — the editor's rolling autosave is not an authored artifact.
# Named scenes under game/scenes/ ARE committed; autosave is not.
**/autosave.scene.json

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local-only environment
.env
.env.local

# Transport-only artifact of build-bundle.js; bundle.json is the committed form.
game/data/bundle.min.json

# Runtime scratch written by the Workshop; the persisted selection IS committed.
game/data/bots/__draft.json
game/data/bots/__player.json

# Recorded match telemetry (T-5.14) — data, not source. Export from the engine
# project when you need to run game/data/ai/aggregate.js.
game/telemetry/
game/data/ai/weights.suggested.json
game/data/last-match.json
game/data/history.json
game/data/session.json
game/data/return-to.json
