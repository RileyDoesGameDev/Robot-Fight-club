  "aiWeights": {
    "$comment": "Utility-AI weights (T-5.18, T-5.20). Score for an action = bias + sum(weight * consideration), every consideration normalised 0..1. Tuning lives here so it needs no recompile — see docs/DESIGN.md section 5 'The opponent AI'. A weight's SIGN is the interesting part: 'proximity: -0.5' on charge means charging is attractive when far away, not that being close is bad.",
    "considerations": {
      "proximity": "1 at contact, 0 at maxRangeM or beyond",
      "alignment": "1 nose exactly on the target, 0 facing directly away",
      "ownHealth": "1 undamaged, 0 dead — mean part hp fraction",
      "foeHealth": "same, for the target",
      "weaponSpin": "0..1 of the weapon's target rpm; 0 for a bot with no weapon",
      "hazardNear": "1 on the lip of a pit, 0 at hazardRadiusM or beyond",
      "wallNear": "1 against a wall, 0 in the centre",
      "foeHazard": "1 when the TARGET is on a pit lip — the push-it-in opportunity",
      "stuck": "1 when we asked for throttle and barely moved",
      "bladeDown": "1 - weaponSpin. Its own consideration because a NEGATIVE weight on weaponSpin contributes nothing when weaponSpin is already 0 — it can only penalise a spinning blade, never reward a stopped one. 'Spin up when the blade is slow' has to be said with a positive weight on the absence.",
      "weaponLost": "1 when this bot has no usable weapon at all — none fitted, or its head has been sheared off. Distinct from bladeDown on purpose: a blade that is merely still spinning up wants spin-up, whereas a blade that is GONE wants ram, and one consideration covering both made every bot ram forever the moment a weapon was lost.",
      "engaged": "how long we have been nose-to-nose, over attackDwellSeconds. The signal that a grind is not working — the scripted AiDriver spent this as a hard ATTACK_DWELL timer; here it is a consideration, so breaking off competes with attacking instead of pre-empting it."
    },
    "tuning": {
      "maxRangeM": 6,
      "engageRangeM": 2.2,
      "backoffRangeM": 0.75,
      "hazardRadiusM": 2.4,
      "arenaHalfM": 5.6,
      "uprightDot": 0.35,
      "stuckSpeedMps": 0.35,
      "stuckSeconds": 1.2,
      "alignToleranceRad": 0.3,
      "hysteresisBonus": 0.15,
      "minDwellSeconds": 0.45,
      "healthPollSeconds": 0.5,
      "strafeBiasRad": 0.55,
      "attackDwellSeconds": 2.5,
      "engagedProximity": 0.8
    },
