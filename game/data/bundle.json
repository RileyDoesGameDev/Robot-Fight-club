  "damage": {
    "$comment": "Force-based. The solver already reports contact force (physics.getContacts .maxForce, newtons), so damage is a RATE over the excess above a floor rather than an energy derived from velocities — deriving energy would duplicate what the solver computed. damage = max(0, maxForce - damageFloorN) * damageScaleHpPerNs * weaponFactor * (1 - armorReduction) * dt",
    "damageFloorN": 600,
    "damageScaleHpPerNs": 0.02,
    "weaponFactor": {
      "spinnerHorizontal": 1,
      "drumVertical": 0.9,
      "hammer": 1.3,
      "flipper": 0.3,
      "wedge": 0.15,
      "ram": 0.5,
      "hazard": 1.2
    },
    "armorReduction": {
      "none": 0,
      "light": 0.15,
      "medium": 0.3,
      "heavy": 0.45
    },
    "damagedAtHpFraction": 0.5,
    "damagedBreakForceMultiplier": 0.5,
    "damagedDriveTorqueMultiplier": 0.55,
    "damagedWeaponRpmMultiplier": 0.6,
    "damagedMotorOutputMultiplier": 0.6,
    "damagedArmorReductionMultiplier": 0.5,
    "armorCoverageDotMin": 0.35,
    "contactForceEventThresholdN": 400,
    "pitKillY": -0.9,
    "debrisLifetimeSeconds": 12
  },
  "weightClasses": {
    "$comment": "1 unit = 1 m, 1 mass unit = 1 kg. Mass is the sum of every PartDef.mass in a blueprint. Lightweight raised 60 -> 80 on 2026-08-20: at 60 the lightest rolling bot (59 kg) could not carry any weapon.",
    "socketGridM": 0.02,
    "classes": [
      {
        "id": "light",
